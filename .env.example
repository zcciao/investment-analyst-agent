# Copy this file to `.env` and fill in your keys.

# ---------- Provider selection ----------
# Set to "gemini" (default) or "anthropic".
PROVIDER=gemini

# ---------- Anthropic (PROVIDER=anthropic) ----------
# Required when PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Google Gemini (PROVIDER=gemini) ----------
# Required when PROVIDER=gemini. Get a key at https://aistudio.google.com/
GOOGLE_API_KEY=AIza...

# Optional: which Gemini model to use. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
