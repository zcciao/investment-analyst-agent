# Copy this file to `.env` and fill in your keys.

# Required: Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: server bind address.
HOST=127.0.0.1
PORT=8000
